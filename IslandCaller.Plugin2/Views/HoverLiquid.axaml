<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IslandCaller.Controls"
        xmlns:materials="using:MorerialsAvalonia"
        xmlns:vm="using:IslandCaller.ViewModels"
        x:Class="IslandCaller.Views.HoverLiquid"
        x:DataType="vm:HoverFluentViewModel"
        Background="Transparent"
        SizeToContent="Manual"
        MinWidth="0"
        MinHeight="0"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Focusable="False"
        HorizontalAlignment="Center"
        HorizontalContentAlignment="Center"
        VerticalAlignment="Center"
        VerticalContentAlignment="Center">
    <Window.DataContext>
        <vm:HoverFluentViewModel />
    </Window.DataContext>
    <materials:MaterialHost x:Name="Materials"
                            ExcludeWindowFromCapture="True"
                            EnableOcclusionPause="True"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
        <controls:HoverLiquidControl x:Name="HoverControl"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Focusable="False"/>
    </materials:MaterialHost>
</Window>
