<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ci="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:IslandCaller.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Focusable="False"
             x:Class="IslandCaller.Controls.HoverFluentControl"
             x:DataType="vm:HoverFluentViewModel">
    <Design.DataContext>
        <vm:HoverFluentViewModel />
    </Design.DataContext>
    <StackPanel
        x:Name="DragSurfacePanel"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="7"
        Margin="7"
        Background="Transparent"
        Focusable="False">
        <Button
            x:Name="Button1"
            Height="56"
            Width="88"
            Classes="accent"
            Focusable="False"
            IsEnabled="{Binding IsEnabled}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="3"
                Focusable="False">
                <ci:FluentIcon Glyph="{Binding Glyph1}" FontSize="28" Focusable="False" Foreground="White"/>
                <TextBlock x:Name="CallText" Text="Call" FontFamily="HarmonyOS Sans SC" FontWeight="Medium" FontSize="21" VerticalAlignment="Center" Focusable="False" Foreground="White"/>
            </StackPanel>
        </Button>
        <Button
            x:Name="Button2"
            Height="56"
            Width="58"
            IsEnabled="{Binding IsEnabled}"
            Focusable="False">
            <ci:FluentIcon Glyph="{Binding Glyph2}" FontSize="28" Focusable="False"/>
        </Button>
    </StackPanel>
</UserControl>
