<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>True</AvaloniaUseCompiledBindingsByDefault>
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <!-- Copy package dependencies automatically for dynamic plugin loading. -->
        <EnableDynamicLoading>True</EnableDynamicLoading>
    </PropertyGroup>

    <PropertyGroup>
        <ClassIslandPluginSdkVersion>2.1.1.1</ClassIslandPluginSdkVersion>
        <WindowsSdkNetVersion>10.0.26100.87</WindowsSdkNetVersion>
        <!-- Use the SDK projection version required by MorerialsAvalonia while keeping 19041 as the OS floor. -->
        <WindowsSdkPackageVersion>$(WindowsSdkNetVersion)</WindowsSdkPackageVersion>
    </PropertyGroup>

    <PropertyGroup Label="Avalonia">
      <AvaloniaXamlCreateSourceInfo>True</AvaloniaXamlCreateSourceInfo>
      <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1.1">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="SuperAutoIsland.Interface" Version="0.3.9.1-dev.2" GeneratePathProperty="true" />
        <PackageReference Include="MorerialsAvalonia" Version="1.1.1" />
        <PackageReference Include="OmniTTS.Shared" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Icon.ico">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Icon.png">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- ClassIsland provides Avalonia and the Windows SDK at runtime. Keep the
         dynamic-loading copy set identical to the plugin's original package
         closure instead of bundling host-owned assemblies. -->
    <Target Name="FilterDynamicLoadingDependencies" AfterTargets="ResolvePackageDependenciesForBuild">
        <ItemGroup>
            <_PluginRuntimeDependency Include="@(ReferenceCopyLocalPaths)"
                Condition="'%(Filename)%(Extension)' == 'MorerialsAvalonia.dll'
                       Or '%(Filename)%(Extension)' == 'OmniTTS.Shared.dll'
                       Or '%(Filename)%(Extension)' == 'Silk.NET.Core.dll'
                       Or '%(Filename)%(Extension)' == 'Silk.NET.Maths.dll'
                       Or '%(Filename)%(Extension)' == 'Silk.NET.DXGI.dll'
                       Or '%(Filename)%(Extension)' == 'Silk.NET.Direct3D.Compilers.dll'
                       Or '%(Filename)%(Extension)' == 'Silk.NET.Direct3D11.dll'
                       Or '%(Filename)%(Extension)' == 'SuperAutoIsland.Interface.dll'" />
            <_PluginRuntimeDependency Include="$(PkgSuperAutoIsland_Interface)\lib\net10.0\SuperAutoIsland.Interface.dll" />
            <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
            <ReferenceCopyLocalPaths Include="@(_PluginRuntimeDependency)" />
        </ItemGroup>
    </Target>
</Project>
